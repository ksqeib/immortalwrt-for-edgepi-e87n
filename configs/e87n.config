# EdgePi E87N build seed for official immortalwrt (master, kernel 6.18).
#
# Target and hardware packages come from the Device/edgepi_e87n block in
# target/linux/mediatek/image/filogic.mk. This file adds only the userspace
# choices that block does not cover: LuCI interface, Chinese language, theme.
#
# Usage:
#   cp configs/e87n.config .config
#   make defconfig

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_edgepi_e87n=y

CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---- 中文界面 ----
# 这个符号是 default-settings-chn 的硬依赖，同时 LuCI 各语言包
# (luci-i18n-*-zh-cn) 的 DEFAULT 都挂在它上面，开了它才自动带上。
CONFIG_LUCI_LANG_zh_Hans=y

# ---- 界面与语言 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_luci-theme-material=y

# ---- LuCI 应用 ----
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-advanced-reboot=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-cloudflared=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-wol=y

# ---- 网络唤醒工具 ----
# luci-app-wol 只依赖 etherwake，但它的控制器同时探测 /usr/bin/wakeonlan，
# 缺了会一直提示「安装备选的网络唤醒工具」。注意 wakeonlan 不支持
# interface / broadcast / password 三个参数，那些只有 etherwake 支持。
CONFIG_PACKAGE_wakeonlan=y

# ---- 系统工具 ----
CONFIG_PACKAGE_btop=y

# ---- 屏幕 ----
# 依赖 apply.sh 装进树的 patch/999-nv3007-fbtft.patch（内核驱动）
# 与 package/e87n-screen/（背光用户态）。kmod-fb 会级联打开整个
# fbdev 栈（CONFIG_FB / CONFIG_FB_DEVICE / CONFIG_BACKLIGHT_CLASS_DEVICE
# / CONFIG_FB_TFT），不必手写内核符号。
# 屏幕未上机验证，排线状态未知；出问题可先注释掉这三行回退。
CONFIG_PACKAGE_kmod-fb=y
CONFIG_PACKAGE_kmod-fb-tft-nv3007=y
CONFIG_PACKAGE_e87n-screen=y
