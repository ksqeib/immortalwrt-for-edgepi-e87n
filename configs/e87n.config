# EdgePi E87N build seed for official immortalwrt (master, kernel 6.18).
#
# This file only selects the target and image formats. Everything else --
# kernel modules, firmware, userspace -- comes from the Device/edgepi_e87n
# block in target/linux/mediatek/image/filogic.mk, so that "make defconfig"
# stays reproducible from a two-line seed.
#
# Usage:
#   cp configs/e87n.config .config
#   make defconfig

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_edgepi_e87n=y

CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
