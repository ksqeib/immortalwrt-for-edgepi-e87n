   SUBMENU:=$(VIDEO_MENU)
diff --git a/target/linux/mediatek/dts/mt7987a-edgepi-e87n.dts b/target/linux/mediatek/dts/mt7987a-edgepi-e87n.dts
new file mode 100644
index 0000000000..137e8b15a5
--- /dev/null
+++ b/target/linux/mediatek/dts/mt7987a-edgepi-e87n.dts
@@ -0,0 +1,337 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * EdgePi E87N (MT7987A), eMMC boot.
+ *
+ * Ported to official immortalwrt master (Linux 6.18).
+ * Baseline: the official mt7987a-hiveton-h5000m.dts, which shares this board's
+ * gpio layout (reset pio1, LED pio3/pio4, fan on pwm1) and eMMC boot
+ * scheme. Board-specific values taken from the EN87 vendor tree.
+ *
+ * The E87N has no wireless hardware. Both PCIe controllers carry one M.2 NVMe
+ * 2230 slot each, so pcie0 and pcie1 are both enabled; no wireless package is
+ * selected.
+ *
+ * Board-level nodes are enabled here (uart0, pwm, ssusb, pcie, spi2) because
+ * official mt7987a.dtsi only turns on boottrap/infra_bus_prot/lvts/trng/watchdog,
+ * unlike the EN87 tree which enables them at chip level.
+ */
+
+/dts-v1/;
+#include "mt7987a.dtsi"
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "EdgePi E87N";
+	compatible = "edgepi,e87n", "mediatek,mt7987a", "mediatek,mt7987";
+
+	/*
+	 * 1 GiB DDR4. mt7987a.dtsi carries a "memory" node without a device_type
+	 * property, which the kernel's memory scan ignores, so this node is what
+	 * actually takes effect. Same pattern as every official mt7987 board
+	 * with 1 GiB (glinet-gl-be10000, routerich-be7200, smartrg-mt-rainier).
+	 */
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 0 0x40000000>;
+	};
+
+	aliases {
+		led-boot = &led_sys;
+		led-failsafe = &led_sys;
+		led-running = &led_sys;
+		led-upgrade = &led_sys;
+		serial0 = &uart0;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200n1 root=PARTLABEL=rootfs rootwait rootfstype=squashfs,f2fs";
+		stdout-path = "serial0:115200n8";
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		button-reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		/*
+		 * Green, pio 4. Carries the led-boot/led-running/led-failsafe/
+		 * led-upgrade aliases below.
+		 *
+		 * The board has a third LED that lights as soon as power is
+		 * applied and is not described by any of the DTS sources this port
+		 * was derived from (vendor u-boot, EN87, istoreos all define only
+		 * pio 3 and pio 4). It acts as the hardware power indicator, so no
+		 * software LED_FUNCTION_POWER is defined here.
+		 */
+		led_sys: led-sys {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_GREEN>;
+			gpios = <&pio 4 GPIO_ACTIVE_LOW>;
+		};
+
+		/* Amber, pio 3. Assigned the WAN role. */
+		led-wan {
+			function = LED_FUNCTION_WAN;
+			color = <LED_COLOR_ID_AMBER>;
+			gpios = <&pio 3 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	reg_3p3v: regulator-3p3v {
+		compatible = "regulator-fixed";
+		regulator-name = "fixed-3.3V";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	reg_usb_5v: regulator-usb-5v {
+		compatible = "regulator-fixed";
+		regulator-name = "usb-5v";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	/*
+	 * The panel backlight has no node here on purpose. It is GPIO524, driven
+	 * from userspace by the e87n-screen package. A pwm-backlight node takes
+	 * that pin (PCM_MCK_I2S_MCLK / pwm2_0), which leaves the panel dark and
+	 * the GPIO unexportable. PWM2 therefore stays unmuxed.
+	 */
+};
+
+&eth {
+	status = "okay";
+};
+
+/*
+ * Fan. Two things are set here, and one is deliberately left alone.
+ *
+ * cooling-levels: mt7987a.dtsi ships <0 128 192 255>. E87N's blower is a
+ * small fan whose useful range starts around PWM 100 - below that it hums
+ * without turning - so the array becomes <0 110 175 255>. The cooling-maps in
+ * the same .dtsi reference levels by index (<&fan 1 1>, <&fan 2 2>,
+ * <&fan 3 3>), and that mapping is unchanged: index 1/2/3 now mean 110/175/255.
+ *
+ * trips: overridden below. The stock curve brings the fan up at 40 degC and
+ * only reaches full speed at 115 degC, which is far too late - a router that
+ * idles in the low 50s would sit one step from full speed for its whole life,
+ * and 115 degC is already close to the SoC's 125 degC critical trip. The curve
+ * below starts at 52 degC, steps at 68 degC and is at full speed by 80 degC,
+ * with 4-5 degC of hysteresis so the fan does not hunt around a step.
+ *
+ * NOT overridden: the critical trip stays at the 125 degC value in
+ * mt7987a.dtsi. That is the last line of defence and is a property of the SoC
+ * rather than of this board; lowering it only makes an orderly shutdown more
+ * likely, it does not make the board cooler.
+ *
+ * The vendor tree's 25-step curve is not used: it only makes sense alongside
+ * its fancontrol daemon, which drives pwm1 directly and bypasses the thermal
+ * zone entirely. Nothing in userspace touches pwm1 on this port.
+ */
+&fan {
+	cooling-levels = <0 110 175 255>;
+	pwms = <&pwm 1 50000 0>;
+	status = "okay";
+};
+
+/*
+ * Fan speed steps. The cooling-maps in mt7987a.dtsi already wire these three
+ * trips to fan levels 1, 2 and 3 in that order, so only the thresholds move.
+ *
+ *   <= 52 degC  level 0 (0)    fan stopped
+ *     52 degC    level 1 (110)  low, just above the fan's start-up voltage
+ *     68 degC    level 2 (175)  sustained high load
+ *     80 degC    level 3 (255)  full speed
+ */
+&cpu_trip_active_low {
+	temperature = <52000>;
+	hysteresis = <4000>;
+};
+
+&cpu_trip_active_med {
+	temperature = <68000>;
+	hysteresis = <5000>;
+};
+
+&cpu_trip_active_high {
+	temperature = <80000>;
+	hysteresis = <5000>;
+};
+
+&gmac0 {
+	phy-mode = "2500base-x";
+	phy-handle = <&phy0>;
+	status = "okay";
+};
+
+&gmac1 {
+	phy-mode = "internal";
+	phy-handle = <&phy1>;
+	status = "okay";
+};
+
+&mdio {
+	/*
+	 * RTL8221B-VB-CG 2.5Gbps PHY, eth0.
+	 * NOTE: E87N wires this PHY at MDIO address 3, not the h5000m value of 1.
+	 */
+	phy0: phy@3 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <3>;
+		reset-gpios = <&pio 42 GPIO_ACTIVE_LOW>;
+		reset-assert-us = <100000>;
+		reset-deassert-us = <100000>;
+		interrupt-parent = <&pio>;
+		interrupts = <41 IRQ_TYPE_LEVEL_LOW>;
+		realtek,aldps-enable;
+	};
+
+	/* built-in 2.5G Ethernet PHY, eth1 */
+	phy1: phy@15 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <15>;
+		pinctrl-names = "i2p5gbe-led";
+		pinctrl-0 = <&i2p5gbe_led0_pins>;
+	};
+};
+
+&mmc0 {
+	pinctrl-names = "default", "state_uhs";
+	pinctrl-0 = <&mmc_pins_default>;
+	pinctrl-1 = <&mmc_pins_uhs>;
+	bus-width = <8>;
+	max-frequency = <48000000>;
+	cap-mmc-highspeed;
+	vmmc-supply = <&reg_3p3v>;
+	non-removable;
+	status = "okay";
+
+	card@0 {
+		compatible = "mmc-card";
+		reg = <0>;
+
+		block {
+			compatible = "block-device";
+
+			partitions {
+				block-partition-factory {
+					partname = "factory";
+
+					nvmem-layout {
+						compatible = "fixed-layout";
+						#address-cells = <1>;
+						#size-cells = <1>;
+
+						eeprom_factory_0: eeprom@0 {
+							reg = <0x0 0x1000>;
+						};
+					};
+				};
+			};
+		};
+	};
+};
+
+/*
+ * Two M.2 NVMe 2230 slots, one per controller. No reset-gpios on either: the
+ * only button on the board is the system reset key, which is wired to the SoC
+ * and used for factory reset / u-boot menu, not for the SSDs.
+ *
+ * Note the vendor u-boot tree (bl-mt798x-dhcpd) enables pcie0 only, because
+ * the bootloader has no need for the second slot. That is a bootloader choice,
+ * not a hardware restriction.
+ */
+&pcie0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie0_pins>;
+	/* E87N wires PCIe PERST# to pio 36, active high. Same pin as the
+	 * official mt7987a-hiveton-h5000m (sister board) and as the istoreos
+	 * E87N port. Without it both controllers never leave detect.quiet. */
+	reset-gpios = <&pio 36 GPIO_ACTIVE_HIGH>;
+	status = "okay";
+};
+
+&pcie1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie1_pins>;
+	status = "okay";
+};
+
+&pio {
+	pwm_fan_pins: pwm-fan-pins {
+		mux {
+			function = "pwm";
+			groups = "pwm1_0";
+		};
+	};
+};
+
+&pwm {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm_fan_pins>;
+};
+
+/*
+ * NV3007 142x428 SPI panel on spi2, which comes up as /dev/fb0 through the
+ * fbtft driver added by the patch in target/linux/mediatek/patches-6.18/.
+ *
+ * spi2 is disabled in mt7987a.dtsi. E87N boots from eMMC, so the controller is
+ * free. The panel needs only CLK/MOSI/CS; spi2_flash_pins is the group the
+ * known-good OEM DTB uses, so it is reused here.
+ *
+ * Backlight is not described here - see the comment near the top of the file.
+ * GPIO524 is driven from userspace by e87n-screen.
+ */
+&spi2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi2_flash_pins>;
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	display@0 {
+		compatible = "newvisionu,nv3007";
+		reg = <0>;
+		regwidth = <8>;
+		buswidth = <8>;
+		width = <142>;
+		height = <428>;
+		fps = <100>;
+		rotate = <270>;
+		reset-gpios = <&pio 10 GPIO_ACTIVE_LOW>;
+		dc-gpios = <&pio 11 GPIO_ACTIVE_HIGH>;
+		spi-max-frequency = <52000000>;
+		status = "okay";
+	};
+};
+
+&ssusb {
+	status = "okay";
+	vusb33-supply = <&reg_3p3v>;
+	vbus-supply = <&reg_usb_5v>;
+};
+
+&tphyu3port0 {
+	status = "okay";
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pins>;
+	status = "okay";
+};
