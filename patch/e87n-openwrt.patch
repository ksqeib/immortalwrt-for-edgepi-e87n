diff --git a/target/linux/mediatek/filogic/base-files/etc/uci-defaults/99-e87n-hw-offload b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/99-e87n-hw-offload
new file mode 100644
index 0000000000..0bd3302934
--- /dev/null
+++ b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/99-e87n-hw-offload
@@ -0,0 +1,22 @@
+#!/bin/sh
+# EdgePi E87N: enable hardware flow offloading.
+#
+# The official firewall default only sets flow_offloading (software). The
+# MT7987 ethernet driver declares .offload_version = 2 / .ppe_num = 2, so the
+# PPE can offload NAT flows in hardware -- but firewall4 only programs the
+# flowtable when flow_offloading_hw is set too.
+#
+# Guarded by board name: this file lives in the shared filogic base-files, so
+# without the case it would touch every MT798x board.
+
+. /lib/functions.sh
+
+case "$(board_name)" in
+edgepi,e87n)
+	uci -q set firewall.@defaults[0].flow_offloading='1'
+	uci -q set firewall.@defaults[0].flow_offloading_hw='1'
+	uci -q commit firewall
+	;;
+esac
+
+exit 0
