diff --git a/target/linux/mediatek/filogic/base-files/etc/uci-defaults/99-e87n-theme b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/99-e87n-theme
new file mode 100644
index 0000000000..622c764ff3
--- /dev/null
+++ b/target/linux/mediatek/filogic/base-files/etc/uci-defaults/99-e87n-theme
@@ -0,0 +1,29 @@
+#!/bin/sh
+# EdgePi E87N: default LuCI theme.
+#
+# luci-base ships /etc/config/luci with mediaurlbase already set to
+# '/luci-static/bootstrap', and every theme's 30_luci-theme-* script only
+# writes that option when it is unset:
+#
+#     set_opt() {
+#         if ! uci -q get "luci.$key" 2>/dev/null; then
+#             uci set "luci.$key=$val"
+#
+# So installing luci-theme-material is not enough -- the option is pre-set,
+# every theme script skips it, and the UI keeps using bootstrap.
+#
+# This file sorts after the 30_* scripts, so it runs later and sets the
+# theme unconditionally.
+#
+# Guarded by board name: this lives in the shared filogic base-files.
+
+. /lib/functions.sh
+
+case "$(board_name)" in
+edgepi,e87n)
+	uci -q set luci.main.mediaurlbase='/luci-static/material'
+	uci -q commit luci
+	;;
+esac
+
+exit 0
