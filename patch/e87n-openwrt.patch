diff --git a/target/linux/mediatek/image/filogic.mk b/target/linux/mediatek/image/filogic.mk
index d16ae5ecb1..98eaa7a9f5 100644
--- a/target/linux/mediatek/image/filogic.mk
+++ b/target/linux/mediatek/image/filogic.mk
@@ -2186,6 +2186,31 @@ define Device/h3c_magic-nx30-pro
 endef
 TARGET_DEVICES += h3c_magic-nx30-pro
 
+define Device/edgepi_e87n
+  DEVICE_VENDOR := EdgePi
+  DEVICE_MODEL := E87N
+  DEVICE_DTS := mt7987a-edgepi-e87n
+  DEVICE_DTS_DIR := ../dts
+  BOARD_NAME := edgepi,e87n
+  KERNEL_LOADADDR := 0x40080000
+  DEVICE_PACKAGES := \
+	-wpad-openssl \
+	mt7987-2p5g-phy-firmware \
+	kmod-hwmon-pwmfan kmod-usb3 \
+	kmod-usb-storage kmod-usb-storage-uas \
+	kmod-fs-ext4 kmod-fs-vfat kmod-fs-exfat kmod-fs-ntfs3 \
+	automount \
+	kmod-gpio-button-hotplug kmod-leds-gpio \
